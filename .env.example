# Copia este archivo a .env y complétalo. .env está en .gitignore.
# Comprueba que todo funciona con:  npm run correo

# ── Correo (enlaces de acceso, invitaciones y alertas) ────────────────────────
# Con Google Workspace hace falta una CONTRASEÑA DE APLICACIÓN, no la contraseña
# normal de la cuenta: https://myaccount.google.com/apppasswords
# (Requiere tener activada la verificación en dos pasos.)
# Puedes pegarla con espacios o sin ellos, da igual.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu.correo@xertica.com
SMTP_PASS=xxxxxxxxxxxxxxxx
# Opcional: remitente visible. Por defecto usa SMTP_USER.
# SMTP_FROM="SEACE Alertas" <alertas@estudio.pe>

# ── Enlaces de los correos ────────────────────────────────────────────────────
# IMPORTANTE al desplegar: los enlaces de acceso, invitación y baja se construyen
# con esto. Si se queda en localhost, nadie fuera de tu equipo podrá entrar.
BASE_URL=http://localhost:4321

# ── Opcionales ────────────────────────────────────────────────────────────────
# PORT=4321
# REGISTRO_ABIERTO=1   # deja que cualquiera se dé de alta pidiendo un enlace.
#                      # Por defecto está CERRADO: se entra por invitación o con
#                      # `npm run usuario -- --crear`.
# COOKIE_SECURE=1      # actívalo cuando sirvas por HTTPS.
# CUENTAS_DB=/ruta/a/cuentas.db   # útil para respaldos o para pruebas.
